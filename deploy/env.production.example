# ==============================================================================
# ArcApply — Configuration de Production
# ==============================================================================

# Clé API Groq (Optionnelle pour les améliorations IA avancées de lettre)
GROQ_API_KEY=

# Modèle Groq recommandé (faible latence et respect des quotas)
GROQ_MODEL=qwen/qwen3.8-27b

# Répertoire de données persistant
ARCAPPLY_DATA_DIR=/root/.arcapply
ARCAPPLY_DB_FILENAME=arcapply.db
